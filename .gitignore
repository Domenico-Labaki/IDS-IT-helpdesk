# =============================================================================
# IT Help Desk & Ticketing System — Root .gitignore
# Covers: General, PostgreSQL, Docker, and shared secrets/certs
# =============================================================================


# =============================================================================
# GENERAL
# =============================================================================

SESSION_STARTER.txt

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor directories and files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln.docstates
*.user

# Logs
logs/
*.log

# Environment variable files — NEVER commit these
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging
*.env


# =============================================================================
# POSTGRESQL
# =============================================================================

# PostgreSQL dump files
*.dump
*.sql.gz
*.backup

# pgAdmin query history
*.pgpass


# =============================================================================
# DOCKER (if used later)
# =============================================================================

# Docker override files with local credentials
docker-compose.override.yml
docker-compose.local.yml


# =============================================================================
# SECRETS & CERTIFICATES — critical, never commit
# =============================================================================

*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
secrets.json
secrets.*.json